# Template: render locally before installation.
[Unit]
Description=Capture2Doc durable single-GPU worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@SERVER_DIR@
ExecStart=@EXECUTABLE@ worker --config @CONFIG_FILE@
Restart=on-failure
RestartSec=10
UMask=0077
Environment="PATH=@BIN_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/wsl/lib"
NoNewPrivileges=true
PrivateTmp=false
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target

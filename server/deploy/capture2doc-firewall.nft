# Load as a dedicated table; never flush the machine's existing ruleset.
# Includes loopback/local health checks, leaves SSH and unrelated services unchanged.
table inet capture2doc {
    chain input {
        type filter hook input priority -10; policy accept;
        tcp dport @PORT@ iifname "lo" accept
        ip saddr @TRUSTED_PROXY@ tcp dport @PORT@ accept
        tcp dport @PORT@ drop
    }
}

# Template: render locally before installation.
[Unit]
Description=Capture2Doc authenticated HTTP and SSE API
After=network-online.target capture2doc-firewall.service
Requires=capture2doc-firewall.service
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@SERVER_DIR@
ExecStart=@EXECUTABLE@ api --config @CONFIG_FILE@
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
KillMode=control-group
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
